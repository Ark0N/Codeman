{
  "name": "xterm-zerolag-input",
  "version": "0.4.0",
  "description": "Instant keystroke feedback overlay for xterm.js: Mosh-inspired local echo that removes perceived input latency over SSH, tunnels and other high-RTT connections",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "xterm",
    "xterm.js",
    "terminal",
    "web-terminal",
    "local-echo",
    "local echo",
    "mosh",
    "input-latency",
    "latency",
    "zero-lag",
    "keystroke",
    "ssh",
    "remote-terminal",
    "overlay",
    "addon",
    "predictive",
    "write-through"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Ark0N/Codeman/tree/master/packages/xterm-zerolag-input#readme",
  "bugs": {
    "url": "https://github.com/Ark0N/Codeman/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ark0N/Codeman.git",
    "directory": "packages/xterm-zerolag-input"
  },
  "devDependencies": {
    "@xterm/headless": "^6.0.0",
    "jsdom": "^24.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}
